# Database Configuration / Configuration Base de Données
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/casablanca_traffic
DATABASE_POOL_SIZE=20
DATABASE_MAX_OVERFLOW=10

# Redis Configuration / Configuration Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=

# API Keys / Clés API
GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here
MAPBOX_API_KEY=your_mapbox_api_key_here
OPENWEATHER_API_KEY=your_openweather_api_key_here

# Server Configuration / Configuration Serveur
SERVER_HOST=0.0.0.0
SERVER_PORT=8000
DEBUG=True
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# Data Collection / Collection de Données
DATA_COLLECTION_INTERVAL=900  # 15 minutes in seconds
WEATHER_COLLECTION_INTERVAL=3600  # 1 hour in seconds

# ML Model / Modèle ML
MODEL_PATH=./models/lstm_traffic_model.h5
SCALER_PATH=./models/traffic_scaler.pkl
